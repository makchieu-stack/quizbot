# Настройки бота по умолчанию. Свои значения пишите в файл .env (он не попадает на GitHub
# и не заменяется при обновлении) — значения из .env главнее.

# Токен бота от @BotFather. НЕ публикуйте его: по токену любой может управлять ботом.
BOT_TOKEN=ВСТАВЬ_ТОКЕН_СЮДА

# Ваш Telegram ID: в вашу личку с ботом сохраняется общая память (для двух компьютеров).
# Узнать свой ID можно, например, у бота @userinfobot.
OWNER_ID=

# 1 = запускать/останавливать квиз могут только админы группы, 0 = все
ADMINS_ONLY=0

# Доля вопросов о кино в /q при теме «все», в процентах
MOVIES_SHARE=10
